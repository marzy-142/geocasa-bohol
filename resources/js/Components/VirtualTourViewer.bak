<template>
    <div class="virtual-tour-viewer-360">
        <div ref="viewerContainer" class="viewer-container"></div>
        <div v-if="!imageUrl" class="placeholder">
            <p>No 360° image provided.</p>
        </div>
    </div>
</template>

<script>
// To use this component, install Photo Sphere Viewer:
// npm install @photo-sphere-viewer/core
import { Viewer } from '@photo-sphere-viewer/core';
import '@photo-sphere-viewer/core/index.css';

export default {
    name: 'VirtualTourViewer360',
    props: {
        imageUrl: {
            type: String,
            default: ''
        }
    },
    mounted() {
        if (this.imageUrl) {
            this.initViewer();
        }
    },
    watch: {
        imageUrl(newVal) {
            if (newVal) {
                this.initViewer();
            }
        }
    },
    methods: {
        initViewer() {
            if (!this.imageUrl) return;
            if (this.viewer) {
                this.viewer.setPanorama(this.imageUrl);
                return;
            }
            this.viewer = new Viewer({
                container: this.$refs.viewerContainer,
                panorama: this.imageUrl,
                navbar: [
                    'zoom', 'fullscreen'
                ]
            });
        }
    },
    beforeDestroy() {
        if (this.viewer) {
            this.viewer.destroy();
        }
    }
}
</script>

<style scoped>
.virtual-tour-viewer-360 {
    width: 100%;
    min-height: 300px;
    position: relative;
}
.viewer-container {
    width: 100%;
    height: 300px;
    background: #222;
    border-radius: 8px;
    overflow: hidden;
}
.placeholder {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #888;
    background: #f5f5f5;
    border-radius: 8px;
}
</style>
